{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/local.properties)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/service-account*.json)",
      "Bash(git push --force:*)",
      "Bash(rm -rf /:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-lint.sh"
          }
        ]
      }
    ]
  }
}
